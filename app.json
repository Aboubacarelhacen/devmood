{
  "expo": {
    "name": "DevMood",
    "slug": "devmood",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/res.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/res.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.aboubacarelhacen.devmood",
      "adaptiveIcon": {
        "foregroundImage": "./assets/res.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "8b284fca-eac1-42fc-a4d0-b635a4b22eec"
      }
    }
  }
}
